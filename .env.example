# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace with your MongoDB Atlas URI or local MongoDB URI
MONGO_URI=your_mongodb_connection_string_here

EMAIL_HOST=host
EMAIL_PORT=port
EMAIL_USER=usermail
EMAIL_PASS=password
EMAIL_FROM=from

#Jwt secret key
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
